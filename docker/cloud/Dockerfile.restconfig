FROM geoservercloud/geoserver-cloud-rest:3.0.1.1
ARG LIBS=libs
COPY ${LIBS}/*.jar /tmp/mcp-libs/
# Skip artifacts the base already ships in the same major version (jackson 2, reactor): its copy comes first in classpath.idx.
RUN cd /opt/app/bin && for f in /tmp/mcp-libs/*.jar; do \
      p="$(basename "$f" | sed -E 's/^(.*-[0-9]+\.).*/\1/')"; \
      if ls BOOT-INF/lib/"$p"*.jar >/dev/null 2>&1; then echo "skip $(basename "$f")"; rm "$f"; continue; fi; \
      j="BOOT-INF/lib/$(basename "$f")"; \
      mv "$f" "$j"; \
      printf -- '- "%s"\n' "$j" >> BOOT-INF/classpath.idx; \
    done && rmdir /tmp/mcp-libs
ENV AOT_MODE=off
